{
  "id": "biomed_re_workflow",
  "name": "Biomedical RE Pipeline (Loop + Branch + RE)",
  "description": "Loop (nested loop + NER) -> Branch gate -> Relation extraction (Kimi)",
  "nodes": [
    "START",
    "biomed_process_loop",
    "biomed_re_branch",
    "biomed_relation_extract",
    "END"
  ],
  "edges": [
    ["START", "biomed_process_loop"],
    ["biomed_process_loop", "biomed_re_branch"],
    ["biomed_re_branch", "biomed_relation_extract"],
    ["biomed_relation_extract", "END"]
  ],
  "flowNodes": {
    "biomed_process_loop": {
      "kind": "loop",
      "name": "NER Processing Loop",
      "subgraphId": "biomed_process_loop",
      "loopConfig": {
        "loopType": "foreach",
        "array": "{{ text }}"
      }
    },
    "biomed_re_branch": {
      "kind": "branch",
      "name": "RE Branch Gate",
      "conditions": [
        { "label": "Has entities", "condition": "entities" },
        { "label": "Skip RE", "condition": "!entities" }
      ]
    }
  },
  "bindings": {
    "biomed_relation_extract": {
      "text": "{{ biomed_re_branch.text }}",
      "entities": "{{ biomed_process_loop.entities }}"
    }
  },
  "created_at": "2026-05-25T20:00:00"
}
