{
  "id": "wf_doc_ner_llm_eval",
  "name": "Doc NER Eval (LLM)",
  "description": "Split document then LLM NER with metrics.",
  "dataset": "doc_ner",
  "task": "ner",
  "engine": "llm",
  "flow_pattern": "linear",
  "nodes": [
    "START",
    "text_sentence_split",
    "ner_llm",
    "eval_metrics",
    "END"
  ],
  "edges": [
    [
      "START",
      "text_sentence_split"
    ],
    [
      "text_sentence_split",
      "ner_llm"
    ],
    [
      "ner_llm",
      "eval_metrics"
    ],
    [
      "eval_metrics",
      "END"
    ]
  ],
  "flowNodes": {},
  "bindings": {
    "ner_llm": {
      "text": "{{ START.text }}",
      "labels": "{{ START.labels }}"
    },
    "eval_metrics": {
      "expected": "{{ START.expected_entities }}",
      "predicted": "{{ ner_llm.entities }}"
    }
  }
}
