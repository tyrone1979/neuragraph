{
  "name": "CID RE Pipeline (linear)",
  "description": "Gold entities → e2e dedup by id → e2e hypernym filter (with text context) → pair list → foreach RE verify → id pairs. Upgraded from wf_e2e_flair_opt_re agents.",
  "nodes": [
    "START",
    "e2e_entities_dedup_by_id",
    "e2e_hypernym_filter",
    "cid_pair_generate",
    "cid_re_verify_loop",
    "END"
  ],
  "edges": [
    ["START", "e2e_entities_dedup_by_id"],
    ["e2e_entities_dedup_by_id", "e2e_hypernym_filter"],
    ["e2e_hypernym_filter", "cid_pair_generate"],
    ["cid_pair_generate", "cid_re_verify_loop"],
    ["cid_re_verify_loop", "END"]
  ],
  "metrics": [
    {
      "type": "relation_pairs",
      "expected": {
        "from": "input",
        "field": "gold_relations"
      },
      "predicted": {
        "from": "state",
        "field": "relations"
      }
    }
  ],
  "flowNodes": {
    "cid_re_verify_loop": {
      "kind": "loop",
      "name": "Verify each Chemical-Disease pair",
      "subgraphId": "sg_cid_re_verify",
      "loopConfig": {
        "loopType": "foreach",
        "array": "{{ pairs }}",
        "itemBindings": {
          "text": "{{ text }}",
          "head": "{{ head }}",
          "tail": "{{ tail }}",
          "head_id": "{{ head_id }}",
          "tail_id": "{{ tail_id }}"
        }
      }
    }
  },
  "bindings": {
    "e2e_entities_dedup_by_id": {
      "entities": "{{ START.entities }}"
    },
    "e2e_hypernym_filter": {
      "entities": "{{ filtered_entities }}",
      "text": "{{ START.text }}"
    },
    "cid_pair_generate": {
      "filtered_entities": "{{ filtered_entities }}"
    }
  }
}
