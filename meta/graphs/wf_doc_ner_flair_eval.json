{
  "id": "wf_doc_ner_flair_eval",
  "name": "Doc NER Eval (Flair)",
  "description": "Document Flair NER with metrics (replaces bio_ner_graph).",
  "dataset": "doc_ner",
  "task": "ner",
  "engine": "flair",
  "flow_pattern": "linear",
  "nodes": [
    "START",
    "ner_flair_doc",
    "eval_metrics",
    "END"
  ],
  "edges": [
    [
      "START",
      "ner_flair_doc"
    ],
    [
      "ner_flair_doc",
      "eval_metrics"
    ],
    [
      "eval_metrics",
      "END"
    ]
  ],
  "flowNodes": {},
  "bindings": {
    "ner_flair_doc": {
      "text": "{{ START.text }}",
      "labels": "{{ START.labels }}"
    },
    "eval_metrics": {
      "expected": "{{ START.expected_entities }}",
      "predicted": "{{ ner_flair_doc.entities }}"
    }
  }
}
