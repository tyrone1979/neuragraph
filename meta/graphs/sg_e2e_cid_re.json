{
  "name": "E2E CID RE (subgraph)",
  "description": "Subgraph: hypernym filter → pair gen → verify loop → MeSH id pair relations. Input: text + entities. Output: relations as ['D... | D...'].",
  "nodes": [
    "START",
    "ontology_hypernym_filter",
    "cid_pair_generate",
    "cid_re_verify_loop",
    "END"
  ],
  "edges": [
    ["START", "ontology_hypernym_filter"],
    ["ontology_hypernym_filter", "cid_pair_generate"],
    ["cid_pair_generate", "cid_re_verify_loop"],
    ["cid_re_verify_loop", "END"]
  ],
  "flowNodes": {
    "cid_re_verify_loop": {
      "kind": "loop",
      "name": "Verify each Chemical-Disease pair",
      "subgraphId": "sg_cid_re_verify",
      "loopConfig": {
        "loopType": "foreach",
        "array": "{{ pairs }}",
        "itemBindings": {
          "text": "{{ text }}",
          "head": "{{ head }}",
          "tail": "{{ tail }}",
          "head_id": "{{ head_id }}",
          "tail_id": "{{ tail_id }}"
        }
      }
    }
  },
  "bindings": {
    "ontology_hypernym_filter": { "entities": "{{ entities }}" },
    "cid_pair_generate": { "filtered_entities": "{{ filtered_entities }}" }
  }
}
