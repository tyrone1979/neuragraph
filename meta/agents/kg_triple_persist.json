{
  "name": "Triple CSV Persistence (PGM)",
  "type": "PGM",
  "inputs": [
    "doc_id",
    "triples",
    "synonyms"
  ],
  "outputs": {
    "name": "output",
    "type": "list"
  },
  "persistence": {
    "columns": [
      "head",
      "verb",
      "tail"
    ],
    "file_path": "./result",
    "file_type": "csv"
  },
  "process": "__result__ = state.get('triples') or []",
  "engine": "pgm"
}
