{
  "name": "Tree-based RE",
  "description": "syntax_dep_parse → relation_from_tree_llm per sentence.",
  "nodes": [
    "START",
    "syntax_dep_parse",
    "relation_from_tree_llm",
    "END"
  ],
  "edges": [
    [
      "START",
      "syntax_dep_parse"
    ],
    [
      "syntax_dep_parse",
      "relation_from_tree_llm"
    ],
    [
      "relation_from_tree_llm",
      "END"
    ]
  ],
  "bindings": {
    "syntax_dep_parse": {
      "sentence": "{{ sentence }}"
    },
    "relation_from_tree_llm": {
      "tree": "{{ syntax_dep_parse.tree }}"
    }
  }
}
