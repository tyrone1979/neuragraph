{"entities":"[{\"text\": \"vancomycin\", \"id\": \"D014640\", \"label\": \"Chemical\"}, {\"text\": \"vancomycin\", \"id\": \"D014640\", \"label\": \"Chemical\"}, {\"text\": \"Vancomycin\", \"id\": \"D014640\", \"label\": \"Chemical\"}, {\"text\": \"infection\", \"id\": \"D007239\", \"label\": \"Disease\"}, {\"text\": \"vancomycin\", \"id\": \"D014640\", \"label\": \"Chemical\"}, {\"text\": \"thrombophlebitis\", \"id\": \"D013924\", \"label\": \"Disease\"}, {\"text\": \"rash\", \"id\": \"D005076\", \"label\": \"Disease\"}, {\"text\": \"nephrotoxicity\", \"id\": \"D007674\", \"label\": \"Disease\"}, {\"text\": \"proteinuria\", \"id\": \"D011507\", \"label\": \"Disease\"}, {\"text\": \"ototoxicity\", \"id\": \"D006311\", \"label\": \"Disease\"}, {\"text\": \"Thrombophlebitis\", \"id\": \"D013924\", \"label\": \"Disease\"}, {\"text\": \"nephrotoxicity\", \"id\": \"D007674\", \"label\": \"Disease\"}, {\"text\": \"ototoxicity\", \"id\": \"D006311\", \"label\": \"Disease\"}, {\"text\": \"aminoglycoside\", \"id\": \"D000617\", \"label\": \"Chemical\"}, {\"text\": \"vancomycin\", \"id\": \"D014640\", \"label\": \"Chemical\"}, {\"text\": \"vancomycin\", \"id\": \"D014640\", \"label\": \"Chemical\"}, {\"text\": \"infections\", \"id\": \"D007239\", \"label\": \"Disease\"}]","filtered_entities":[{"text":"vancomycin","id":"D014640","label":"Chemical"},{"text":"infections","id":"D007239","label":"Disease"},{"text":"thrombophlebitis","id":"D013924","label":"Disease"},{"text":"rash","id":"D005076","label":"Disease"},{"text":"nephrotoxicity","id":"D007674","label":"Disease"},{"text":"proteinuria","id":"D011507","label":"Disease"},{"text":"ototoxicity","id":"D006311","label":"Disease"},{"text":"aminoglycoside","id":"D000617","label":"Chemical"}],"head":"aminoglycoside","head_id":"D000617","pairs":[{"head":"vancomycin","tail":"infections","head_id":"D014640","tail_id":"D007239"},{"head":"vancomycin","tail":"thrombophlebitis","head_id":"D014640","tail_id":"D013924"},{"head":"vancomycin","tail":"rash","head_id":"D014640","tail_id":"D005076"},{"head":"vancomycin","tail":"nephrotoxicity","head_id":"D014640","tail_id":"D007674"},{"head":"vancomycin","tail":"proteinuria","head_id":"D014640","tail_id":"D011507"},{"head":"vancomycin","tail":"ototoxicity","head_id":"D014640","tail_id":"D006311"},{"head":"aminoglycoside","tail":"infections","head_id":"D000617","tail_id":"D007239"},{"head":"aminoglycoside","tail":"thrombophlebitis","head_id":"D000617","tail_id":"D013924"},{"head":"aminoglycoside","tail":"rash","head_id":"D000617","tail_id":"D005076"},{"head":"aminoglycoside","tail":"nephrotoxicity","head_id":"D000617","tail_id":"D007674"},{"head":"aminoglycoside","tail":"proteinuria","head_id":"D000617","tail_id":"D011507"},{"head":"aminoglycoside","tail":"ototoxicity","head_id":"D000617","tail_id":"D006311"}],"relations":["D014640 | D013924","D014640 | D005076","D014640 | D007674","D014640 | D011507","D014640 | D006311","D000617 | D007674","D000617 | D011507","D000617 | D006311"],"result":"$","tail":"ototoxicity","tail_id":"D006311","text":"A prospective study of adverse reactions associated with vancomycin therapy. A prospective evaluation of the efficacy and safety of vancomycin was conducted in 54 consecutive patients over a 16-month period. Vancomycin was curative in 95% of 43 patients with proven infection. Drugs were ceased in six patients because of adverse reactions; in three of these vancomycin was considered the likely cause. Reactions included thrombophlebitis (20 of 54 patients), rash (4 of 54), nephrotoxicity (4 of 50), proteinuria (1 of 50) and ototoxicity (1 of 11 patients tested by audiometry). Thrombophlebitis occurred only with infusion through peripheral cannulae; nephrotoxicity and ototoxicity were confined to patients receiving an aminoglycoside plus vancomycin. We conclude that vancomycin, administered appropriately, constitutes safe, effective therapy for infections caused by susceptible bacteria.","metrics":{"precision":0.5,"recall":1.0,"f1":0.6666666666666666,"rel_tp":4,"rel_fp":4,"rel_fn":0}}