:"lithium","id":"1","label":"Chemical"},{"text":"blood glucose","id":"2","label":"Chemical"},{"text":"hyperosmolar nonketotic coma","id":"1","label":"Disease"},{"text":"nephrogenic diabetes insipidus","id":"2","label":"Disease"},{"text":"manic depression","id":"3","label":"Disease"},{"text":"polydipsia","id":"5","label":"Disease"},{"text":"type 2 diabetes","id":"6","label":"Disease"}],"gold_relations":"lithium | CID | polyuria\nlithium | CID | nephrogenic diabetes insipidus\nlithium | CID | hyperosmolar, nonketotic coma","labels":"Chemical,Disease","metrics":{"precision":0.6666666666666666,"recall":0.6666666666666666,"f1":0.6666666666666666,"tp":2,"fp":1,"fn":1,"rel_precision":0.6666666666666666,"rel_recall":0.6666666666666666,"rel_f1":0.6666666666666666,"rel_tp":2,"rel_fp":1,"rel_fn":1},"pairs":[{"head":"lithium","tail":"hyperosmolar nonketotic coma","head_id":"1","tail_id":"1"},{"head":"lithium","tail":"nephrogenic diabetes insipidus","head_id":"1","tail_id":"2"},{"head":"lithium","tail":"manic depression","head_id":"1","tail_id":"3"},{"head":"lithium","tail":"polydipsia","head_id":"1","tail_id":"5"},{"head":"lithium","tail":"type 2 diabetes","head_id":"1","tail_id":"6"},{"head":"blood glucose","tail":"hyperosmolar nonketotic coma","head_id":"2","tail_id":"1"},{"head":"blood glucose","tail":"nephrogenic diabetes insipidus","head_id":"2","tail_id":"2"},{"head":"blood glucose","tail":"manic depression","head_id":"2","tail_id":"3"},{"head":"blood glucose","tail":"polydipsia","head_id":"2","tail_id":"5"},{"head":"blood glucose","tail":"type 2 diabetes","head_id":"2","tail_id":"6"}],"relations":["1 | 1","1 | 2","1 | 5"],"text":"Hyperosmolar nonketotic coma precipitated by lithium-induced nephrogenic diabetes insipidus. A 45-year-old man, with a 10-year history of manic depression treated with lithium, was admitted with hyperosmolar, nonketotic coma. He gave a five-year history of polyuria and polydipsia, during which time urinalysis had been negative for glucose. After recovery from hyperglycaemia, he remained polyuric despite normal blood glucose concentrations; water deprivation testing indicated nephrogenic diabetes insipidus, likely to be lithium-induced. We hypothesize that when this man developed type 2 diabetes, chronic polyuria due to nephrogenic diabetes insipidus was sufficient to precipitate hyperosmolar dehydration."}