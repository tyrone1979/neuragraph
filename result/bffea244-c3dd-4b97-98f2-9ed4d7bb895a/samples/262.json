precision":0.6,"recall":1.0,"f1":0.75,"tp":3,"fp":2,"fn":0,"rel_precision":0.6,"rel_recall":1.0,"rel_f1":0.75,"rel_tp":3,"rel_fp":2,"rel_fn":0},"pairs":[{"head":"Suxamethonium","tail":"jaw stiffness","head_id":"1","tail_id":"1"},{"head":"Suxamethonium","tail":"myalgia","head_id":"1","tail_id":"2"},{"head":"Suxamethonium","tail":"apnoea","head_id":"1","tail_id":"3"},{"head":"halothane","tail":"jaw stiffness","head_id":"2","tail_id":"1"},{"head":"halothane","tail":"myalgia","head_id":"2","tail_id":"2"},{"head":"halothane","tail":"apnoea","head_id":"2","tail_id":"3"},{"head":"nitrous oxide","tail":"jaw stiffness","head_id":"3","tail_id":"1"},{"head":"nitrous oxide","tail":"myalgia","head_id":"3","tail_id":"2"},{"head":"nitrous oxide","tail":"apnoea","head_id":"3","tail_id":"3"},{"head":"oxygen","tail":"jaw stiffness","head_id":"4","tail_id":"1"},{"head":"oxygen","tail":"myalgia","head_id":"4","tail_id":"2"},{"head":"oxygen","tail":"apnoea","head_id":"4","tail_id":"3"},{"head":"pancuronium","tail":"jaw stiffness","head_id":"5","tail_id":"1"},{"head":"pancuronium","tail":"myalgia","head_id":"5","tail_id":"2"},{"head":"pancuronium","tail":"apnoea","head_id":"5","tail_id":"3"},{"head":"dibucaine","tail":"jaw stiffness","head_id":"6","tail_id":"1"},{"head":"dibucaine","tail":"myalgia","head_id":"6","tail_id":"2"},{"head":"dibucaine","tail":"apnoea","head_id":"6","tail_id":"3"}],"relations":["1 | 1","1 | 2","1 | 3","3 | 1","5 | 1"],"text":"Suxamethonium-induced jaw stiffness and myalgia associated with atypical cholinesterase: case report. An 11-year-old boy was given halothane, nitrous oxide and oxygen, pancuronium 0.4 mg and suxamethonium 100 mg for induction of anaesthesia. In response to this a marked jaw stiffness occurred which lasted for two minutes and the anaesthesia were terminated. Four hours of apnoea ensued and he suffered generalized severe myalgia lasting for one week. He was found to have atypical plasma cholinesterase with a dibucaine number of 12, indicating homozygocity. This was verified by study of the family. The case shows that prolonged jaw rigidity and myalgia may occur after suxamethonium in patients with atypical cholinesterase despite pretreatment with pancuronium."}