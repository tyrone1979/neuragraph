l_id":"D000140"},{"head":"zidovudine","tail":"immune reconstitution syndrome","head_id":"D015215","tail_id":"D054019"},{"head":"zidovudine","tail":"toxicities","head_id":"D015215","tail_id":"D064420"},{"head":"efavirenz","tail":"HIV-infected","head_id":"C098320","tail_id":"D015658"},{"head":"efavirenz","tail":"rash","head_id":"C098320","tail_id":"D005076"},{"head":"efavirenz","tail":"peripheral neuropathy","head_id":"C098320","tail_id":"D010523"},{"head":"efavirenz","tail":"anemia","head_id":"C098320","tail_id":"D000740"},{"head":"efavirenz","tail":"hepatitis","head_id":"C098320","tail_id":"D056486"},{"head":"efavirenz","tail":"jaundice","head_id":"C098320","tail_id":"D007565"},{"head":"efavirenz","tail":"lactic acidosis","head_id":"C098320","tail_id":"D000140"},{"head":"efavirenz","tail":"immune reconstitution syndrome","head_id":"C098320","tail_id":"D054019"},{"head":"efavirenz","tail":"toxicities","head_id":"C098320","tail_id":"D064420"},{"head":"alanine","tail":"HIV-infected","head_id":"D000409","tail_id":"D015658"},{"head":"alanine","tail":"rash","head_id":"D000409","tail_id":"D005076"},{"head":"alanine","tail":"peripheral neuropathy","head_id":"D000409","tail_id":"D010523"},{"head":"alanine","tail":"anemia","head_id":"D000409","tail_id":"D000740"},{"head":"alanine","tail":"hepatitis","head_id":"D000409","tail_id":"D056486"},{"head":"alanine","tail":"jaundice","head_id":"D000409","tail_id":"D007565"},{"head":"alanine","tail":"lactic acidosis","head_id":"D000409","tail_id":"D000140"},{"head":"alanine","tail":"immune reconstitution syndrome","head_id":"D000409","tail_id":"D054019"},{"head":"alanine","tail":"toxicities","head_id":"D000409","tail_id":"D064420"}],"relations":["D019259 | D005076","D019259 | D010523","D019259 | D000740","D019259 | D056486","D019259 | D007565","D019259 | D054019","D019259 | D064420","D018119 | D005076","D018119 | D010523","D018119 | D064420","D019829 | D005076","D019829 | D056486","D019829 | D007565","D019829 | D064420","D015215 | D005076","D015215 | D000740","D015215 | D056486","D015215 | D064420","C098320 | D005076","C098320 | D056486","C098320 | D064420"],"result":"~","tail":"toxicities","tail_id":"D064420","text":"Spectrum of adverse events after generic HAART in southern Indian HIV-infected patients. To determine the incidence of clinically significant adverse events after long-term, fixed-dose, generic highly active antiretroviral therapy (HAART) use among HIV-infected individuals in South India, we examined the experiences of 3154 HIV-infected individuals who received a minimum of 3 months of generic HAART between February 1996 and December 2006 at a tertiary HIV care referral center in South India. The most common regimens were 3TC + d4T + nevirapine (NVP) (54.8%), zidovudine (AZT) + 3TC + NVP (14.5%), 3TC + d4T + efavirenz (EFV) (20.1%), and AZT + 3TC + EFV (5.4%). The most common adverse events and median CD4 at time of event were rash (15.2%; CD4, 285 cells/microL) and peripheral neuropathy (9.0% and 348 cells/microL). Clinically significant anemia (hemoglobin <7 g/dL) was observed in 5.4% of patients (CD4, 165 cells/microL) and hepatitis (clinical jaundice with alanine aminotransferase > 5 times upper limits of normal) in 3.5% of patients (CD4, 260 cells/microL). Women were significantly more likely to experience lactic acidosis, while men were significantly more likely to experience immune reconstitution syndrome (p < 0.05). Among the patients with 1 year of follow-up, NVP therapy was significantly associated with developing rash and d4T therapy with developing peripheral neuropathy (p < 0.05). Anemia and hepatitis often occur within 12 weeks of initiating generic HAART. Frequent and early monitoring for these toxicities is warranted in developing countries where generic HAART is increasingly available.","metrics":{"precision":0.09523809523809523,"recall":1.0,"f1":0.17391304347826086,"rel_tp":2,"rel_fp":19,"rel_fn":0}}