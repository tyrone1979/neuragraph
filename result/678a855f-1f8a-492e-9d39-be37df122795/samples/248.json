{"entities":"[{\"text\": \"amphetamine\", \"id\": \"D000661\", \"label\": \"Chemical\"}, {\"text\": \"noradrenaline\", \"id\": \"D009638\", \"label\": \"Chemical\"}, {\"text\": \"DSP4\", \"id\": \"C012102\", \"label\": \"Chemical\"}, {\"text\": \"D-amphetamine\", \"id\": \"D003913\", \"label\": \"Chemical\"}, {\"text\": \"hyperactivity\", \"id\": \"D006948\", \"label\": \"Disease\"}, {\"text\": \"D-amphetamine\", \"id\": \"D003913\", \"label\": \"Chemical\"}, {\"text\": \"DSP4\", \"id\": \"C012102\", \"label\": \"Chemical\"}, {\"text\": \"amphetamine\", \"id\": \"D000661\", \"label\": \"Chemical\"}, {\"text\": \"stereotypies\", \"id\": \"D019956\", \"label\": \"Disease\"}, {\"text\": \"DSP4\", \"id\": \"C012102\", \"label\": \"Chemical\"}, {\"text\": \"amphetamine\", \"id\": \"D000661\", \"label\": \"Chemical\"}, {\"text\": \"hyperactivity\", \"id\": \"D006948\", \"label\": \"Disease\"}, {\"text\": \"DSP4\", \"id\": \"C012102\", \"label\": \"Chemical\"}, {\"text\": \"noradrenaline\", \"id\": \"D009638\", \"label\": \"Chemical\"}, {\"text\": \"desipramine\", \"id\": \"D003891\", \"label\": \"Chemical\"}, {\"text\": \"neurotoxic\", \"id\": \"D020258\", \"label\": \"Disease\"}, {\"text\": \"DSP4\", \"id\": \"C012102\", \"label\": \"Chemical\"}, {\"text\": \"amphetamine\", \"id\": \"D000661\", \"label\": \"Chemical\"}]","filtered_entities":[{"text":"amphetamine","id":"D000661","label":"Chemical"},{"text":"noradrenaline","id":"D009638","label":"Chemical"},{"text":"DSP4","id":"C012102","label":"Chemical"},{"text":"D-amphetamine","id":"D003913","label":"Chemical"},{"text":"hyperactivity","id":"D006948","label":"Disease"},{"text":"stereotypies","id":"D019956","label":"Disease"},{"text":"desipramine","id":"D003891","label":"Chemical"},{"text":"neurotoxic","id":"D020258","label":"Disease"}],"head":"desipramine","head_id":"D003891","pairs":[{"head":"amphetamine","tail":"hyperactivity","head_id":"D000661","tail_id":"D006948"},{"head":"amphetamine","tail":"stereotypies","head_id":"D000661","tail_id":"D019956"},{"head":"amphetamine","tail":"neurotoxic","head_id":"D000661","tail_id":"D020258"},{"head":"noradrenaline","tail":"hyperactivity","head_id":"D009638","tail_id":"D006948"},{"head":"noradrenaline","tail":"stereotypies","head_id":"D009638","tail_id":"D019956"},{"head":"noradrenaline","tail":"neurotoxic","head_id":"D009638","tail_id":"D020258"},{"head":"DSP4","tail":"hyperactivity","head_id":"C012102","tail_id":"D006948"},{"head":"DSP4","tail":"stereotypies","head_id":"C012102","tail_id":"D019956"},{"head":"DSP4","tail":"neurotoxic","head_id":"C012102","tail_id":"D020258"},{"head":"D-amphetamine","tail":"hyperactivity","head_id":"D003913","tail_id":"D006948"},{"head":"D-amphetamine","tail":"stereotypies","head_id":"D003913","tail_id":"D019956"},{"head":"D-amphetamine","tail":"neurotoxic","head_id":"D003913","tail_id":"D020258"},{"head":"desipramine","tail":"hyperactivity","head_id":"D003891","tail_id":"D006948"},{"head":"desipramine","tail":"stereotypies","head_id":"D003891","tail_id":"D019956"},{"head":"desipramine","tail":"neurotoxic","head_id":"D003891","tail_id":"D020258"}],"relations":["D000661 | D006948","D000661 | D019956","C012102 | D020258","D003913 | D006948","D003913 | D019956"],"result":"~","tail":"neurotoxic","tail_id":"D020258","text":"Evidence for a selective brain noradrenergic involvement in the locomotor stimulant effects of amphetamine in the rat. Male rats received the noradrenaline neurotoxin DSP4 (50 mg/kg) 7 days prior to injection of D-amphetamine (10 or 40 mumol/kg i.p.). The hyperactivity induced by D-amphetamine (10 mumol/kg) was significantly reduced by DSP4 pretreatment. However, the increased rearings and the amphetamine-induced stereotypies were not blocked by pretreatment with DSP4. The reduction of amphetamine hyperactivity induced by DSP4 was blocked by pretreatment with the noradrenaline-uptake blocking agent, desipramine, which prevents the neurotoxic action of DSP4. The present results suggest a selective involvement of central noradrenergic neurones in the locomotor stimulant effect of amphetamine in the rat.","metrics":{"precision":0.2,"recall":1.0,"f1":0.3333333333333333,"rel_tp":1,"rel_fp":4,"rel_fn":0}}