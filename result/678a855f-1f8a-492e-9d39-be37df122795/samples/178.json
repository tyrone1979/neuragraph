{"entities":"[{\"text\": \"lindane\", \"id\": \"D001556\", \"label\": \"Chemical\"}, {\"text\": \"GABA\", \"id\": \"D005680\", \"label\": \"Chemical\"}, {\"text\": \"dopamine\", \"id\": \"D004298\", \"label\": \"Chemical\"}, {\"text\": \"Lindane\", \"id\": \"D001556\", \"label\": \"Chemical\"}, {\"text\": \"gamma-hexachlorocyclohexane\", \"id\": \"D001556\", \"label\": \"Chemical\"}, {\"text\": \"neurotoxic\", \"id\": \"D020258\", \"label\": \"Disease\"}, {\"text\": \"lindane\", \"id\": \"D001556\", \"label\": \"Chemical\"}, {\"text\": \"gamma-aminobutyric acid\", \"id\": \"D005680\", \"label\": \"Chemical\"}, {\"text\": \"GABA\", \"id\": \"D005680\", \"label\": \"Chemical\"}, {\"text\": \"lindane\", \"id\": \"D001556\", \"label\": \"Chemical\"}, {\"text\": \"GABA\", \"id\": \"D005680\", \"label\": \"Chemical\"}, {\"text\": \"dopamine\", \"id\": \"D004298\", \"label\": \"Chemical\"}, {\"text\": \"seizures\", \"id\": \"D012640\", \"label\": \"Disease\"}, {\"text\": \"convulsions\", \"id\": \"D012640\", \"label\": \"Disease\"}, {\"text\": \"lindane\", \"id\": \"D001556\", \"label\": \"Chemical\"}, {\"text\": \"GABA\", \"id\": \"D005680\", \"label\": \"Chemical\"}, {\"text\": \"dopamine\", \"id\": \"D004298\", \"label\": \"Chemical\"}, {\"text\": \"DOPAC\", \"id\": \"D015102\", \"label\": \"Chemical\"}]","filtered_entities":[{"text":"gamma-hexachlorocyclohexane","id":"D001556","label":"Chemical"},{"text":"gamma-aminobutyric acid","id":"D005680","label":"Chemical"},{"text":"dopamine","id":"D004298","label":"Chemical"},{"text":"neurotoxic","id":"D020258","label":"Disease"},{"text":"convulsions","id":"D012640","label":"Disease"},{"text":"DOPAC","id":"D015102","label":"Chemical"}],"head":"DOPAC","head_id":"D015102","pairs":[{"head":"gamma-hexachlorocyclohexane","tail":"neurotoxic","head_id":"D001556","tail_id":"D020258"},{"head":"gamma-hexachlorocyclohexane","tail":"convulsions","head_id":"D001556","tail_id":"D012640"},{"head":"gamma-aminobutyric acid","tail":"neurotoxic","head_id":"D005680","tail_id":"D020258"},{"head":"gamma-aminobutyric acid","tail":"convulsions","head_id":"D005680","tail_id":"D012640"},{"head":"dopamine","tail":"neurotoxic","head_id":"D004298","tail_id":"D020258"},{"head":"dopamine","tail":"convulsions","head_id":"D004298","tail_id":"D012640"},{"head":"DOPAC","tail":"neurotoxic","head_id":"D015102","tail_id":"D020258"},{"head":"DOPAC","tail":"convulsions","head_id":"D015102","tail_id":"D012640"}],"relations":["D001556 | D020258","D001556 | D012640"],"result":"~","tail":"convulsions","tail_id":"D012640","text":"Convulsant effect of lindane and regional brain concentration of GABA and dopamine. Lindane (gamma-hexachlorocyclohexane) is an organochlorine insecticide with known neurotoxic effects. Its mechanism of action is not well understood although it has been proposed that lindane acts as a non-competitive antagonist at the gamma-aminobutyric acid (GABA)-A receptor. We studied the effect of lindane (150 mg/kg) on the GABAergic and dopaminergic systems by measuring the concentration of GABA, dopamine and its metabolites in 7 brain areas at the onset of seizures. All animals suffered tonic convulsions at 18.3 +/- 1.4 min after lindane administration. The concentration of GABA was only slightly but significantly decreased in the colliculi without modifications in the other areas. The concentration of dopamine was increased in the mesencephalon and that of its metabolite DOPAC was also increased in the mesencephalon and the striatum.","metrics":{"precision":0.5,"recall":1.0,"f1":0.6666666666666666,"rel_tp":1,"rel_fp":1,"rel_fn":0}}