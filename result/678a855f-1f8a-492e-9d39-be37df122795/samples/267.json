d":"D001919","label":"Disease"},{"text":"ventricular tachycardia","id":"D017180","label":"Disease"},{"text":"ventricular fibrillation","id":"D014693","label":"Disease"},{"text":"seizures","id":"D012640","label":"Disease"},{"text":"toxicity","id":"D064420","label":"Disease"}],"head":"cocaine","head_id":"D003042","pairs":[{"head":"lidocaine","tail":"myocardial infarction","head_id":"D008012","tail_id":"D009203"},{"head":"lidocaine","tail":"bradydysrhythmias","head_id":"D008012","tail_id":"D001919"},{"head":"lidocaine","tail":"ventricular tachycardia","head_id":"D008012","tail_id":"D017180"},{"head":"lidocaine","tail":"ventricular fibrillation","head_id":"D008012","tail_id":"D014693"},{"head":"lidocaine","tail":"seizures","head_id":"D008012","tail_id":"D012640"},{"head":"lidocaine","tail":"toxicity","head_id":"D008012","tail_id":"D064420"},{"head":"cocaine","tail":"myocardial infarction","head_id":"D003042","tail_id":"D009203"},{"head":"cocaine","tail":"bradydysrhythmias","head_id":"D003042","tail_id":"D001919"},{"head":"cocaine","tail":"ventricular tachycardia","head_id":"D003042","tail_id":"D017180"},{"head":"cocaine","tail":"ventricular fibrillation","head_id":"D003042","tail_id":"D014693"},{"head":"cocaine","tail":"seizures","head_id":"D003042","tail_id":"D012640"},{"head":"cocaine","tail":"toxicity","head_id":"D003042","tail_id":"D064420"}],"relations":["D003042 | D009203","D003042 | D064420"],"result":"$","tail":"toxicity","tail_id":"D064420","text":"Clinical safety of lidocaine in patients with cocaine-associated myocardial infarction. STUDY OBJECTIVE: To evaluate the safety of lidocaine in the setting of cocaine-induced myocardial infarction (MI). DESIGN: A retrospective, multicenter study. SETTING: Twenty-nine university, university-affiliated, or community hospitals during a 6-year period (total of 117 cumulative hospital-years). PARTICIPANTS: Patients with cocaine-associated MI who received lidocaine in the emergency department. RESULTS: Of 29 patients who received lidocaine in the setting of cocaine-associated MI, no patient died; exhibited bradydysrhythmias, ventricular tachycardia, or ventricular fibrillation; or experienced seizures after administration of lidocaine (95% confidence interval, 0% to 11%). CONCLUSION: Despite theoretical concerns that lidocaine may enhance cocaine toxicity, the use of lidocaine in patients with cocaine-associated MI was not associated with significant cardiovascular or central nervous system toxicity.","metrics":{"precision":0.5,"recall":1.0,"f1":0.6666666666666666,"rel_tp":1,"rel_fp":1,"rel_fn":0}}