: \"C056595\", \"label\": \"Chemical\"}, {\"text\": \"calcium\", \"id\": \"D002118\", \"label\": \"Chemical\"}, {\"text\": \"epinephrine\", \"id\": \"D004837\", \"label\": \"Chemical\"}, {\"text\": \"clentiazem\", \"id\": \"C056595\", \"label\": \"Chemical\"}, {\"text\": \"calcium\", \"id\": \"D002118\", \"label\": \"Chemical\"}, {\"text\": \"epinephrine\", \"id\": \"D004837\", \"label\": \"Chemical\"}, {\"text\": \"clentiazem\", \"id\": \"C056595\", \"label\": \"Chemical\"}, {\"text\": \"epinephrine\", \"id\": \"D004837\", \"label\": \"Chemical\"}, {\"text\": \"cardiac injury\", \"id\": \"D006331\", \"label\": \"Disease\"}]","filtered_entities":[{"text":"clentiazem","id":"C056595","label":"Chemical"},{"text":"epinephrine","id":"D004837","label":"Chemical"},{"text":"cardiac injury","id":"D006331","label":"Disease"},{"text":"1,5-benzothiazepine","id":"C106746","label":"Chemical"},{"text":"calcium","id":"D002118","label":"Chemical"},{"text":"cardiomyopathy","id":"D009202","label":"Disease"},{"text":"ischemic lesions","id":"D007511","label":"Disease"},{"text":"fibrosis","id":"D005355","label":"Disease"},{"text":"isoproterenol","id":"D007545","label":"Chemical"}],"head":"isoproterenol","head_id":"D007545","pairs":[{"head":"clentiazem","tail":"cardiac injury","head_id":"C056595","tail_id":"D006331"},{"head":"clentiazem","tail":"cardiomyopathy","head_id":"C056595","tail_id":"D009202"},{"head":"clentiazem","tail":"ischemic lesions","head_id":"C056595","tail_id":"D007511"},{"head":"clentiazem","tail":"fibrosis","head_id":"C056595","tail_id":"D005355"},{"head":"epinephrine","tail":"cardiac injury","head_id":"D004837","tail_id":"D006331"},{"head":"epinephrine","tail":"cardiomyopathy","head_id":"D004837","tail_id":"D009202"},{"head":"epinephrine","tail":"ischemic lesions","head_id":"D004837","tail_id":"D007511"},{"head":"epinephrine","tail":"fibrosis","head_id":"D004837","tail_id":"D005355"},{"head":"1,5-benzothiazepine","tail":"cardiac injury","head_id":"C106746","tail_id":"D006331"},{"head":"1,5-benzothiazepine","tail":"cardiomyopathy","head_id":"C106746","tail_id":"D009202"},{"head":"1,5-benzothiazepine","tail":"ischemic lesions","head_id":"C106746","tail_id":"D007511"},{"head":"1,5-benzothiazepine","tail":"fibrosis","head_id":"C106746","tail_id":"D005355"},{"head":"calcium","tail":"cardiac injury","head_id":"D002118","tail_id":"D006331"},{"head":"calcium","tail":"cardiomyopathy","head_id":"D002118","tail_id":"D009202"},{"head":"calcium","tail":"ischemic lesions","head_id":"D002118","tail_id":"D007511"},{"head":"calcium","tail":"fibrosis","head_id":"D002118","tail_id":"D005355"},{"head":"isoproterenol","tail":"cardiac injury","head_id":"D007545","tail_id":"D006331"},{"head":"isoproterenol","tail":"cardiomyopathy","head_id":"D007545","tail_id":"D009202"},{"head":"isoproterenol","tail":"ischemic lesions","head_id":"D007545","tail_id":"D007511"},{"head":"isoproterenol","tail":"fibrosis","head_id":"D007545","tail_id":"D005355"}],"relations":["D004837 | D006331","D004837 | D009202","D004837 | D007511","D004837 | D005355"],"result":"~","tail":"fibrosis","tail_id":"D005355","text":"Protective effect of clentiazem against epinephrine-induced cardiac injury in rats. We investigated the effects of clentiazem, a 1,5-benzothiazepine calcium antagonist, on epinephrine-induced cardiomyopathy in rats. With 2-week chronic epinephrine infusion, 16 of 30 rats died within 4 days, and severe ischemic lesions and fibrosis of the left ventricles were observed. In epinephrine-treated rats, left atrial and left ventricular papillary muscle contractile responses to isoproterenol were reduced, but responses to calcium were normal or enhanced compared to controls. Left ventricular alpha and beta adrenoceptor densities were also reduced compared to controls. Treatment with clentiazem prevented epinephrine-induced death (P < .05), and attenuated the ventricular ischemic lesions and fibrosis, in a dose-dependent manner. Left atrial and left ventricular papillary muscle contractile responses to isoproterenol were reduced compared to controls in groups treated with clentiazem alone, but combined with epinephrine, clentiazem restored left atrial responses and enhanced left ventricular papillary responses to isoproterenol. On the other hand clentiazem did not prevent epinephrine-induced down-regulation of alpha and beta adrenoceptors. Interestingly, clentiazem, infused alone, resulted in decreased adrenergic receptor densities in the left ventricle. Clentiazem also did not prevent the enhanced responses to calcium seen in the epinephrine-treated animals, although the high dose of clentiazem partially attenuated the maximal response to calcium compared to epinephrine-treated animals. In conclusion, clentiazem attenuated epinephrine-induced cardiac injury, possibly through its effect on the adrenergic pathway.","metrics":{"precision":0.25,"recall":1.0,"f1":0.4,"rel_tp":1,"rel_fp":3,"rel_fn":0}}