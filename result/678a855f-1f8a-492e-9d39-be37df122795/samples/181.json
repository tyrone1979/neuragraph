{"entities":"[{\"text\": \"Nifedipine\", \"id\": \"D009543\", \"label\": \"Chemical\"}, {\"text\": \"bradycardia\", \"id\": \"D001919\", \"label\": \"Disease\"}, {\"text\": \"autonomic neuropathy\", \"id\": \"D009422\", \"label\": \"Disease\"}, {\"text\": \"diabetic\", \"id\": \"D003920\", \"label\": \"Disease\"}, {\"text\": \"chest pain\", \"id\": \"D002637\", \"label\": \"Disease\"}, {\"text\": \"atrial flutter\", \"id\": \"D001282\", \"label\": \"Disease\"}, {\"text\": \"nifedipine\", \"id\": \"D009543\", \"label\": \"Chemical\"}, {\"text\": \"nifedipine\", \"id\": \"D009543\", \"label\": \"Chemical\"}, {\"text\": \"tachycardia\", \"id\": \"D013610\", \"label\": \"Disease\"}, {\"text\": \"bradycardia\", \"id\": \"D001919\", \"label\": \"Disease\"}]","filtered_entities":[{"text":"Nifedipine","id":"D009543","label":"Chemical"},{"text":"bradycardia","id":"D001919","label":"Disease"},{"text":"autonomic neuropathy","id":"D009422","label":"Disease"},{"text":"diabetic","id":"D003920","label":"Disease"},{"text":"chest pain","id":"D002637","label":"Disease"},{"text":"atrial flutter","id":"D001282","label":"Disease"},{"text":"tachycardia","id":"D013610","label":"Disease"}],"head":"Nifedipine","head_id":"D009543","pairs":[{"head":"Nifedipine","tail":"bradycardia","head_id":"D009543","tail_id":"D001919"},{"head":"Nifedipine","tail":"autonomic neuropathy","head_id":"D009543","tail_id":"D009422"},{"head":"Nifedipine","tail":"diabetic","head_id":"D009543","tail_id":"D003920"},{"head":"Nifedipine","tail":"chest pain","head_id":"D009543","tail_id":"D002637"},{"head":"Nifedipine","tail":"atrial flutter","head_id":"D009543","tail_id":"D001282"},{"head":"Nifedipine","tail":"tachycardia","head_id":"D009543","tail_id":"D013610"}],"relations":["D009543 | D001919"],"result":"~","tail":"tachycardia","tail_id":"D013610","text":"Nifedipine induced bradycardia in a patient with autonomic neuropathy. An 80 year old diabetic male with evidence of peripheral and autonomic neuropathy was admitted with chest pain. He was found to have atrial flutter at a ventricular rate of 70/min which slowed down to 30-40/min when nifedipine (60 mg) in 3 divided doses, during which he was paced at a rate of 70/min. This is inconsistent with the well-established finding that nifedipine induces tachycardia in normally innervated hearts. However, in hearts deprived of compensatory sympathetic drive, it may lead to bradycardia.","metrics":{"precision":1.0,"recall":0.5,"f1":0.6666666666666666,"rel_tp":1,"rel_fp":0,"rel_fn":1}}