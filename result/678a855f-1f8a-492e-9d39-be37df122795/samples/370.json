l\"}, {\"text\": \"cocaine\", \"id\": \"D003042\", \"label\": \"Chemical\"}, {\"text\": \"adenosine\", \"id\": \"D000241\", \"label\": \"Chemical\"}, {\"text\": \"DMPX\", \"id\": \"C057837\", \"label\": \"Chemical\"}, {\"text\": \"3,7-dimethyl-1-propargylxanthine\", \"id\": \"C057837\", \"label\": \"Chemical\"}, {\"text\": \"cocaine\", \"id\": \"D003042\", \"label\": \"Chemical\"}, {\"text\": \"Caffeine\", \"id\": \"D002110\", \"label\": \"Chemical\"}, {\"text\": \"CPT\", \"id\": \"C053907\", \"label\": \"Chemical\"}, {\"text\": \"8-cyclopentyltheophylline\", \"id\": \"C053907\", \"label\": \"Chemical\"}, {\"text\": \"adenosine\", \"id\": \"D000241\", \"label\": \"Chemical\"}, {\"text\": \"amphetamine\", \"id\": \"D000661\", \"label\": \"Chemical\"}, {\"text\": \"hyperactivity\", \"id\": \"D006948\", \"label\": \"Disease\"}, {\"text\": \"cocaine\", \"id\": \"D003042\", \"label\": \"Chemical\"}, {\"text\": \"hyperactivity\", \"id\": \"D006948\", \"label\": \"Disease\"}, {\"text\": \"adenosine\", \"id\": \"D000241\", \"label\": \"Chemical\"}, {\"text\": \"DMPX\", \"id\": \"C057837\", \"label\": \"Chemical\"}, {\"text\": \"adenosine\", \"id\": \"D000241\", \"label\": \"Chemical\"}, {\"text\": \"caffeine\", \"id\": \"D002110\", \"label\": \"Chemical\"}, {\"text\": \"amphetamine\", \"id\": \"D000661\", \"label\": \"Chemical\"}, {\"text\": \"adenosine\", \"id\": \"D000241\", \"label\": \"Chemical\"}, {\"text\": \"cocaine\", \"id\": \"D003042\", \"label\": \"Chemical\"}, {\"text\": \"amphetamine\", \"id\": \"D000661\", \"label\": \"Chemical\"}, {\"text\": \"cocaine\", \"id\": \"D003042\", \"label\": \"Chemical\"}, {\"text\": \"hyperactivity\", \"id\": \"D006948\", \"label\": \"Disease\"}, {\"text\": \"adenosine\", \"id\": \"D000241\", \"label\": \"Chemical\"}, {\"text\": \"amphetamine\", \"id\": \"D000661\", \"label\": \"Chemical\"}, {\"text\": \"hyperactivity\", \"id\": \"D006948\", \"label\": \"Disease\"}]","filtered_entities":[{"text":"Cocaine","id":"D003042","label":"Chemical"},{"text":"hyperactivity","id":"D006948","label":"Disease"},{"text":"adenosine","id":"D000241","label":"Chemical"},{"text":"amphetamine","id":"D000661","label":"Chemical"},{"text":"decreased the locomotor activity","id":"D004409","label":"Disease"},{"text":"2-p-(2-carboxyethyl)phenethylamino-5'-N-ethylcarboxamidoadenosine","id":"C061282","label":"Chemical"},{"text":"N6-cyclopentyladenosine","id":"C048599","label":"Chemical"},{"text":"5'-N-ethylcarboxamidoadenosine","id":"D019830","label":"Chemical"},{"text":"3,7-dimethyl-1-propargylxanthine","id":"C057837","label":"Chemical"},{"text":"Caffeine","id":"D002110","label":"Chemical"},{"text":"8-cyclopentyltheophylline","id":"C053907","label":"Chemical"}],"head":"8-cyclopentyltheophylline","head_id":"C053907","pairs":[{"head":"Cocaine","tail":"hyperactivity","head_id":"D003042","tail_id":"D006948"},{"head":"Cocaine","tail":"decreased the locomotor activity","head_id":"D003042","tail_id":"D004409"},{"head":"adenosine","tail":"hyperactivity","head_id":"D000241","tail_id":"D006948"},{"head":"adenosine","tail":"decreased the locomotor activity","head_id":"D000241","tail_id":"D004409"},{"head":"amphetamine","tail":"hyperactivity","head_id":"D000661","tail_id":"D006948"},{"head":"amphetamine","tail":"decreased the locomotor activity","head_id":"D000661","tail_id":"D004409"},{"head":"2-p-(2-carboxyethyl)phenethylamino-5'-N-ethylcarboxamidoadenosine","tail":"hyperactivity","head_id":"C061282","tail_id":"D006948"},{"head":"2-p-(2-carboxyethyl)phenethylamino-5'-N-ethylcarboxamidoadenosine","tail":"decreased the locomotor activity","head_id":"C061282","tail_id":"D004409"},{"head":"N6-cyclopentyladenosine","tail":"hyperactivity","head_id":"C048599","tail_id":"D006948"},{"head":"N6-cyclopentyladenosine","tail":"decreased the locomotor activity","head_id":"C048599","tail_id":"D004409"},{"head":"5'-N-ethylcarboxamidoadenosine","tail":"hyperactivity","head_id":"D019830","tail_id":"D006948"},{"head":"5'-N-ethylcarboxamidoadenosine","tail":"decreased the locomotor activity","head_id":"D019830","tail_id":"D004409"},{"head":"3,7-dimethyl-1-propargylxanthine","tail":"hyperactivity","head_id":"C057837","tail_id":"D006948"},{"head":"3,7-dimethyl-1-propargylxanthine","tail":"decreased the locomotor activity","head_id":"C057837","tail_id":"D004409"},{"head":"Caffeine","tail":"hyperactivity","head_id":"D002110","tail_id":"D006948"},{"head":"Caffeine","tail":"decreased the locomotor activity","head_id":"D002110","tail_id":"D004409"},{"head":"8-cyclopentyltheophylline","tail":"hyperactivity","head_id":"C053907","tail_id":"D006948"},{"head":"8-cyclopentyltheophylline","tail":"decreased the locomotor activity","head_id":"C053907","tail_id":"D004409"}],"relations":["D003042 | D006948","D000241 | D004409","D000661 | D006948","C061282 | D004409","C048599 | D004409","D019830 | D004409"],"result":"~","tail":"decreased the locomotor activity","tail_id":"D004409","text":"Cocaine-induced hyperactivity is more influenced by adenosine receptor agonists than amphetamine-induced hyperactivity. The influence of adenosine receptor agonists and antagonists on cocaine-and amphetamine-induced hyperactivity was examined in mice. All adenosine receptor agonists significantly decreased the locomotor activity in mice, and the effects were dose-dependent. It seems that adenosine A1 and A2 receptors might be involved in this reaction. Moreover, all adenosine receptor agonists: 2-p-(2-carboxyethyl)phenethylamino-5'-N-ethylcarboxamidoadenosine (CGS 21680), A2A receptor agonist, N6-cyclopentyladenosine (CPA), A1 receptor agonist, and 5'-N-ethylcarboxamidoadenosine (NECA), A2/A1 receptor agonist significantly and dose-dependently decreased cocaine-induced locomotor activity. CPA reduced cocaine action at the doses which, given alone, did not influence motility, while CGS 21680 and NECA decreased the action of cocaine at the doses which, given alone, decreased locomotor activity in animals. These results suggest the involvement of both adenosine receptors in the action of cocaine although agonists of A1 receptors seem to have stronger influence on it. The selective blockade of A2 adenosine receptor by DMPX (3,7-dimethyl-1-propargylxanthine) significantly enhanced cocaine-induced locomotor activity of animals. Caffeine had similar action but the effect was not significant. CPT (8-cyclopentyltheophylline)--A1 receptor antagonist, did not show any influence in this test. Similarly, all adenosine receptor agonists decreased amphetamine-induced hyperactivity, but at the higher doses than those which were active in cocaine-induced hyperactivity. The selective blockade of A2 adenosine receptors (DMPX) and non-selective blockade of adenosine receptors (caffeine) significantly increased the action of amphetamine in the locomotor activity test. Our results have shown that all adenosine receptor agonists (A1 and A2) reduce cocaine- and amphetamine-induced locomotor activity and indicate that cocaine-induced hyperactivity is more influenced by adenosine receptor agonists (particularly A1 receptors) than amphetamine-induced hyperactivity.","metrics":{"precision":0.0,"recall":0.0,"f1":0.0,"rel_tp":0,"rel_fp":6,"rel_fn":3}}