ease\"}, {\"text\": \"PAN\", \"id\": \"D011692\", \"label\": \"Chemical\"}, {\"text\": \"PAN\", \"id\": \"D011692\", \"label\": \"Chemical\"}, {\"text\": \"PAN\", \"id\": \"D011692\", \"label\": \"Chemical\"}, {\"text\": \"temocapril\", \"id\": \"C055603\", \"label\": \"Chemical\"}, {\"text\": \"temocapril\", \"id\": \"C055603\", \"label\": \"Chemical\"}, {\"text\": \"PAN\", \"id\": \"D011692\", \"label\": \"Chemical\"}, {\"text\": \"neprotic\", \"id\": \"D009401\", \"label\": \"Disease\"}]","filtered_entities":[{"text":"Temocapril","id":"C055603","label":"Chemical"},{"text":"angiotensin","id":"D000809","label":"Chemical"},{"text":"glomerular injury","id":"D007674","label":"Disease"},{"text":"puromycin aminonucleoside","id":"D011692","label":"Chemical"},{"text":"nephrosis","id":"D009401","label":"Disease"},{"text":"proteinuria","id":"D011507","label":"Disease"},{"text":"hypertrophy","id":"D006984","label":"Disease"},{"text":"glomerulosclerosis","id":"D005921","label":"Disease"},{"text":"nephrotic","id":"D009404","label":"Disease"}],"head":"puromycin aminonucleoside","head_id":"D011692","pairs":[{"head":"Temocapril","tail":"glomerular injury","head_id":"C055603","tail_id":"D007674"},{"head":"Temocapril","tail":"nephrosis","head_id":"C055603","tail_id":"D009401"},{"head":"Temocapril","tail":"proteinuria","head_id":"C055603","tail_id":"D011507"},{"head":"Temocapril","tail":"hypertrophy","head_id":"C055603","tail_id":"D006984"},{"head":"Temocapril","tail":"glomerulosclerosis","head_id":"C055603","tail_id":"D005921"},{"head":"Temocapril","tail":"nephrotic","head_id":"C055603","tail_id":"D009404"},{"head":"angiotensin","tail":"glomerular injury","head_id":"D000809","tail_id":"D007674"},{"head":"angiotensin","tail":"nephrosis","head_id":"D000809","tail_id":"D009401"},{"head":"angiotensin","tail":"proteinuria","head_id":"D000809","tail_id":"D011507"},{"head":"angiotensin","tail":"hypertrophy","head_id":"D000809","tail_id":"D006984"},{"head":"angiotensin","tail":"glomerulosclerosis","head_id":"D000809","tail_id":"D005921"},{"head":"angiotensin","tail":"nephrotic","head_id":"D000809","tail_id":"D009404"},{"head":"puromycin aminonucleoside","tail":"glomerular injury","head_id":"D011692","tail_id":"D007674"},{"head":"puromycin aminonucleoside","tail":"nephrosis","head_id":"D011692","tail_id":"D009401"},{"head":"puromycin aminonucleoside","tail":"proteinuria","head_id":"D011692","tail_id":"D011507"},{"head":"puromycin aminonucleoside","tail":"hypertrophy","head_id":"D011692","tail_id":"D006984"},{"head":"puromycin aminonucleoside","tail":"glomerulosclerosis","head_id":"D011692","tail_id":"D005921"},{"head":"puromycin aminonucleoside","tail":"nephrotic","head_id":"D011692","tail_id":"D009404"}],"relations":["D011692 | D007674","D011692 | D009401","D011692 | D011507","D011692 | D006984","D011692 | D005921","D011692 | D009404"],"result":"$","tail":"nephrotic","tail_id":"D009404","text":"Temocapril, a long-acting non-SH group angiotensin converting enzyme inhibitor, modulates glomerular injury in chronic puromycin aminonucleoside nephrosis. The purpose of the present study was to determine whether chronic administration of temocapril, a long-acting non-SH group angiotensin converting enzyme (ACE) inhibitor, reduced proteinuria, inhibited glomerular hypertrophy and prevented glomerulosclerosis in chronic puromycin aminonucleoside (PAN) - induced nephrotic rats. Nephrosis was induced by injection of PAN (15mg/100g body weight) in male Sprague-Dawley (SD) rats. Four groups were used, i) the PAN group (14), ii) PAN/temocapril (13), iii) temocapril (14) and iv) untreated controls (15). Temocapril (8 mg/kg/day) was administered to the rats which were killed at weeks 4, 14 or 20. At each time point, systolic blood pressure (BP), urinary protein excretion and renal histopathological findings were evaluated, and morphometric image analysis was done. Systolic BP in the PAN group was significantly high at 4, 14 and 20 weeks, but was normal in the PAN/temocapril group. Urinary protein excretion in the PAN group increased significantly, peaking at 8 days, then decreased at 4 weeks, but rose again significantly at 14 and 20 weeks. Temocapril did not attenuate proteinuria at 8 days, but it did markedly lower it from weeks 4 to 20. The glomerulosclerosis index (GSI) was 6.21 % at 4 weeks and respectively 25.35 % and 30.49 % at 14 and 20 weeks in the PAN group. There was a significant correlation between urinary protein excretion and GSI (r = 0.808, p < 0.0001). The ratio of glomerular tuft area to the area of Bowman's capsules (GT/BC) in the PAN group was significantly increased, but it was significantly lower in the PAN/temocapril group. It appears that temocapril was effective in retarding renal progression and protected renal function in PAN neprotic rats.","metrics":{"precision":0.3333333333333333,"recall":1.0,"f1":0.5,"rel_tp":2,"rel_fp":4,"rel_fn":0}}