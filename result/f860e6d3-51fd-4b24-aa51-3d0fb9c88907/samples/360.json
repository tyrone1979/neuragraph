{"entities":"[{\"text\": \"Pulmonary hypertension\", \"id\": \"D006976\", \"label\": \"Disease\"}, {\"text\": \"ibuprofen\", \"id\": \"D007052\", \"label\": \"Chemical\"}, {\"text\": \"hypoxaemia\", \"id\": \"D000860\", \"label\": \"Disease\"}, {\"text\": \"ibuprofen\", \"id\": \"D007052\", \"label\": \"Chemical\"}, {\"text\": \"patent ductus arteriosus\", \"id\": \"D004374\", \"label\": \"Disease\"}, {\"text\": \"ibuprofen\", \"id\": \"D007052\", \"label\": \"Chemical\"}, {\"text\": \"Hypoxaemia\", \"id\": \"D000860\", \"label\": \"Disease\"}, {\"text\": \"nitric oxide\", \"id\": \"D009569\", \"label\": \"Chemical\"}, {\"text\": \"hypoxaemia\", \"id\": \"D000860\", \"label\": \"Disease\"}, {\"text\": \"ibuprofen\", \"id\": \"D007052\", \"label\": \"Chemical\"}]","filtered_entities":[{"text":"Pulmonary hypertension","id":"D006976","label":"Disease"},{"text":"hypoxaemia","id":"D000860","label":"Disease"},{"text":"patent ductus arteriosus","id":"D004374","label":"Disease"},{"text":"nitric oxide","id":"D009569","label":"Chemical"}],"head":"nitric oxide","head_id":"D009569","pairs":[{"head":"nitric oxide","tail":"Pulmonary hypertension","head_id":"D009569","tail_id":"D006976"},{"head":"nitric oxide","tail":"hypoxaemia","head_id":"D009569","tail_id":"D000860"},{"head":"nitric oxide","tail":"patent ductus arteriosus","head_id":"D009569","tail_id":"D004374"}],"relations":null,"result":"~","tail":"patent ductus arteriosus","tail_id":"D004374","text":"Pulmonary hypertension after ibuprofen prophylaxis in very preterm infants. We report three cases of severe hypoxaemia after ibuprofen administration during a randomised controlled trial of prophylactic treatment of patent ductus arteriosus with ibuprofen in premature infants born at less than 28 weeks of gestation. Echocardiography showed severely decreased pulmonary blood flow. Hypoxaemia resolved quickly on inhaled nitric oxide therapy. We suggest that investigators involved in similar trials pay close attention to pulmonary pressure if hypoxaemia occurs after prophylactic administration of ibuprofen.","metrics":{"precision":0.0,"recall":0.0,"f1":0.0,"rel_tp":0,"rel_fp":0,"rel_fn":2}}