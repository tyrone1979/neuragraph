{"entities":"[{\"text\": \"Bradycardia\", \"id\": \"D001919\", \"label\": \"Disease\"}, {\"text\": \"biperiden\", \"id\": \"D001712\", \"label\": \"Chemical\"}, {\"text\": \"postzosteric\", \"id\": \"D006562\", \"label\": \"Disease\"}, {\"text\": \"trigeminal neuralgia\", \"id\": \"D014277\", \"label\": \"Disease\"}, {\"text\": \"biperiden lactate\", \"id\": \"C036432\", \"label\": \"Chemical\"}, {\"text\": \"bradycardia\", \"id\": \"D001919\", \"label\": \"Disease\"}, {\"text\": \"dysarthria\", \"id\": \"D004401\", \"label\": \"Disease\"}, {\"text\": \"dysphagia\", \"id\": \"D003680\", \"label\": \"Disease\"}, {\"text\": \"orciprenaline\", \"id\": \"D009921\", \"label\": \"Chemical\"}, {\"text\": \"Bradycardia\", \"id\": \"D001919\", \"label\": \"Disease\"}, {\"text\": \"biperiden\", \"id\": \"D001712\", \"label\": \"Chemical\"}, {\"text\": \"atropine\", \"id\": \"D001285\", \"label\": \"Chemical\"}, {\"text\": \"muscarine\", \"id\": \"D009116\", \"label\": \"Chemical\"}]","filtered_entities":[{"text":"postzosteric","id":"D006562","label":"Disease"},{"text":"trigeminal neuralgia","id":"D014277","label":"Disease"},{"text":"biperiden lactate","id":"C036432","label":"Chemical"},{"text":"dysarthria","id":"D004401","label":"Disease"},{"text":"dysphagia","id":"D003680","label":"Disease"},{"text":"orciprenaline","id":"D009921","label":"Chemical"},{"text":"atropine","id":"D001285","label":"Chemical"},{"text":"muscarine","id":"D009116","label":"Chemical"}],"head":"muscarine","head_id":"D009116","pairs":[{"head":"biperiden lactate","tail":"postzosteric","head_id":"C036432","tail_id":"D006562"},{"head":"biperiden lactate","tail":"trigeminal neuralgia","head_id":"C036432","tail_id":"D014277"},{"head":"biperiden lactate","tail":"dysarthria","head_id":"C036432","tail_id":"D004401"},{"head":"biperiden lactate","tail":"dysphagia","head_id":"C036432","tail_id":"D003680"},{"head":"orciprenaline","tail":"postzosteric","head_id":"D009921","tail_id":"D006562"},{"head":"orciprenaline","tail":"trigeminal neuralgia","head_id":"D009921","tail_id":"D014277"},{"head":"orciprenaline","tail":"dysarthria","head_id":"D009921","tail_id":"D004401"},{"head":"orciprenaline","tail":"dysphagia","head_id":"D009921","tail_id":"D003680"},{"head":"atropine","tail":"postzosteric","head_id":"D001285","tail_id":"D006562"},{"head":"atropine","tail":"trigeminal neuralgia","head_id":"D001285","tail_id":"D014277"},{"head":"atropine","tail":"dysarthria","head_id":"D001285","tail_id":"D004401"},{"head":"atropine","tail":"dysphagia","head_id":"D001285","tail_id":"D003680"},{"head":"muscarine","tail":"postzosteric","head_id":"D009116","tail_id":"D006562"},{"head":"muscarine","tail":"trigeminal neuralgia","head_id":"D009116","tail_id":"D014277"},{"head":"muscarine","tail":"dysarthria","head_id":"D009116","tail_id":"D004401"},{"head":"muscarine","tail":"dysphagia","head_id":"D009116","tail_id":"D003680"}],"relations":["C036432 | D004401","C036432 | D003680","D001285 | D003680","D009116 | D003680"],"result":"$","tail":"dysphagia","tail_id":"D003680","text":"Bradycardia due to biperiden. In a 38-year-old male patient suffering from a severe postzosteric trigeminal neuralgia, intravenous application of 10 mg biperiden lactate led to a long-lasting paradoxical reaction characterized by considerable bradycardia, dysarthria, and dysphagia. The heart rate was back to normal within 12 hours upon administration of orciprenaline under cardiac monitoring in an intensive care unit. Bradycardia induced by biperiden is attributed to the speed of injection and to a dose-related dual effect of atropine-like drugs on muscarine receptors.","metrics":{"precision":0.0,"recall":0.0,"f1":0.0,"rel_tp":0,"rel_fp":4,"rel_fn":3}}