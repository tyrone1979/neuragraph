{"entities":"[{\"text\": \"endometrial disease\", \"id\": \"D014591\", \"label\": \"Disease\"}, {\"text\": \"oestrogen\", \"id\": \"D004967\", \"label\": \"Chemical\"}, {\"text\": \"endometrial disease\", \"id\": \"D014591\", \"label\": \"Disease\"}, {\"text\": \"oestrogen\", \"id\": \"D004967\", \"label\": \"Chemical\"}, {\"text\": \"hyperplasia\", \"id\": \"D006965\", \"label\": \"Disease\"}, {\"text\": \"oestrogen\", \"id\": \"D004967\", \"label\": \"Chemical\"}, {\"text\": \"progestagen\", \"id\": \"D011372\", \"label\": \"Chemical\"}, {\"text\": \"norethisterone\", \"id\": \"D009640\", \"label\": \"Chemical\"}, {\"text\": \"hyperplasia\", \"id\": \"D006965\", \"label\": \"Disease\"}, {\"text\": \"hyperplasia\", \"id\": \"D006965\", \"label\": \"Disease\"}, {\"text\": \"endometrial carcinoma\", \"id\": \"D016889\", \"label\": \"Disease\"}, {\"text\": \"oestrogen\", \"id\": \"D004967\", \"label\": \"Chemical\"}, {\"text\": \"hyperplasia\", \"id\": \"D006965\", \"label\": \"Disease\"}, {\"text\": \"malignancy\", \"id\": \"D009369\", \"label\": \"Disease\"}, {\"text\": \"oestrogen\", \"id\": \"D004967\", \"label\": \"Chemical\"}, {\"text\": \"progestagen\", \"id\": \"D011372\", \"label\": \"Chemical\"}, {\"text\": \"endometrial hyperplasia\", \"id\": \"D004714\", \"label\": \"Disease\"}, {\"text\": \"carcinoma\", \"id\": \"D002277\", \"label\": \"Disease\"}]","filtered_entities":[{"text":"endometrial disease","id":"D014591","label":"Disease"},{"text":"oestrogen","id":"D004967","label":"Chemical"},{"text":"hyperplasia","id":"D006965","label":"Disease"},{"text":"progestagen","id":"D011372","label":"Chemical"},{"text":"norethisterone","id":"D009640","label":"Chemical"},{"text":"endometrial carcinoma","id":"D016889","label":"Disease"},{"text":"malignancy","id":"D009369","label":"Disease"},{"text":"endometrial hyperplasia","id":"D004714","label":"Disease"},{"text":"carcinoma","id":"D002277","label":"Disease"}],"head":"norethisterone","head_id":"D009640","pairs":[{"head":"oestrogen","tail":"endometrial disease","head_id":"D004967","tail_id":"D014591"},{"head":"oestrogen","tail":"hyperplasia","head_id":"D004967","tail_id":"D006965"},{"head":"oestrogen","tail":"endometrial carcinoma","head_id":"D004967","tail_id":"D016889"},{"head":"oestrogen","tail":"malignancy","head_id":"D004967","tail_id":"D009369"},{"head":"oestrogen","tail":"endometrial hyperplasia","head_id":"D004967","tail_id":"D004714"},{"head":"oestrogen","tail":"carcinoma","head_id":"D004967","tail_id":"D002277"},{"head":"progestagen","tail":"endometrial disease","head_id":"D011372","tail_id":"D014591"},{"head":"progestagen","tail":"hyperplasia","head_id":"D011372","tail_id":"D006965"},{"head":"progestagen","tail":"endometrial carcinoma","head_id":"D011372","tail_id":"D016889"},{"head":"progestagen","tail":"malignancy","head_id":"D011372","tail_id":"D009369"},{"head":"progestagen","tail":"endometrial hyperplasia","head_id":"D011372","tail_id":"D004714"},{"head":"progestagen","tail":"carcinoma","head_id":"D011372","tail_id":"D002277"},{"head":"norethisterone","tail":"endometrial disease","head_id":"D009640","tail_id":"D014591"},{"head":"norethisterone","tail":"hyperplasia","head_id":"D009640","tail_id":"D006965"},{"head":"norethisterone","tail":"endometrial carcinoma","head_id":"D009640","tail_id":"D016889"},{"head":"norethisterone","tail":"malignancy","head_id":"D009640","tail_id":"D009369"},{"head":"norethisterone","tail":"endometrial hyperplasia","head_id":"D009640","tail_id":"D004714"},{"head":"norethisterone","tail":"carcinoma","head_id":"D009640","tail_id":"D002277"}],"relations":["D004967 | D014591","D004967 | D016889","D004967 | D009369","D004967 | D002277"],"result":"~","tail":"carcinoma","tail_id":"D002277","text":"Prevention and treatment of endometrial disease in climacteric women receiving oestrogen therapy. The treatment regimens are described in 74 patients with endometrial disease among 850 climacteric women receiving oestrogen therapy. Cystic hyperplasia was associated with unopposed oestrogen therapy without progestagen. Two courses of 21 days of 5 mg norethisterone daily caused reversion to normal in all 57 cases of cystic hyperplasia and 6 of the 8 cases of atypical hyperplasia. 4 cases of endometrial carcinoma referred from elsewhere demonstrated the problems of inappropriate and unsupervised unopposed oestrogen therapy and the difficulty in distinguishing severe hyperplasia from malignancy. Cyclical low-dose oestrogen therapy with 7--13 days of progestagen does not seem to increase the risk of endometrial hyperplasia or carcinoma.","metrics":{"precision":0.0,"recall":0.0,"f1":0.0,"rel_tp":0,"rel_fp":4,"rel_fn":1}}