":"Disease"},{"text":"diabetes mellitus","id":"5","label":"Disease"},{"text":"preexisting renal disease","id":"6","label":"Disease"}],"gold_relations":"indomethacin | CID | hyperkalemia\nindomethacin | CID | renal insufficiency","labels":"Chemical,Disease","metrics":{"precision":0.3333333333333333,"recall":1.0,"f1":0.5,"tp":2,"fp":4,"fn":0,"rel_precision":0.3333333333333333,"rel_recall":1.0,"rel_f1":0.5,"rel_tp":2,"rel_fp":4,"rel_fn":0},"pairs":[{"head":"indomethacin","tail":"hyperkalemia","head_id":"1","tail_id":"1"},{"head":"indomethacin","tail":"acute gouty arthritis","head_id":"1","tail_id":"2"},{"head":"indomethacin","tail":"renal insufficiency","head_id":"1","tail_id":"3"},{"head":"indomethacin","tail":"hyporeninemic hypoaidosteronism","head_id":"1","tail_id":"4"},{"head":"indomethacin","tail":"diabetes mellitus","head_id":"1","tail_id":"5"},{"head":"indomethacin","tail":"preexisting renal disease","head_id":"1","tail_id":"6"},{"head":"prostaglandin","tail":"hyperkalemia","head_id":"2","tail_id":"1"},{"head":"prostaglandin","tail":"acute gouty arthritis","head_id":"2","tail_id":"2"},{"head":"prostaglandin","tail":"renal insufficiency","head_id":"2","tail_id":"3"},{"head":"prostaglandin","tail":"hyporeninemic hypoaidosteronism","head_id":"2","tail_id":"4"},{"head":"prostaglandin","tail":"diabetes mellitus","head_id":"2","tail_id":"5"},{"head":"prostaglandin","tail":"preexisting renal disease","head_id":"2","tail_id":"6"},{"head":"potassium","tail":"hyperkalemia","head_id":"3","tail_id":"1"},{"head":"potassium","tail":"acute gouty arthritis","head_id":"3","tail_id":"2"},{"head":"potassium","tail":"renal insufficiency","head_id":"3","tail_id":"3"},{"head":"potassium","tail":"hyporeninemic hypoaidosteronism","head_id":"3","tail_id":"4"},{"head":"potassium","tail":"diabetes mellitus","head_id":"3","tail_id":"5"},{"head":"potassium","tail":"preexisting renal disease","head_id":"3","tail_id":"6"},{"head":"nonsteroidal anti-inflammatory agents","tail":"hyperkalemia","head_id":"4","tail_id":"1"},{"head":"nonsteroidal anti-inflammatory agents","tail":"acute gouty arthritis","head_id":"4","tail_id":"2"},{"head":"nonsteroidal anti-inflammatory agents","tail":"renal insufficiency","head_id":"4","tail_id":"3"},{"head":"nonsteroidal anti-inflammatory agents","tail":"hyporeninemic hypoaidosteronism","head_id":"4","tail_id":"4"},{"head":"nonsteroidal anti-inflammatory agents","tail":"diabetes mellitus","head_id":"4","tail_id":"5"},{"head":"nonsteroidal anti-inflammatory agents","tail":"preexisting renal disease","head_id":"4","tail_id":"6"}],"relations":["1 | 1","1 | 3","1 | 4","4 | 1","4 | 3","4 | 4"],"sentences":["Indomethacin-induced hyperkalemia in three patients with gouty arthritis.","We describe three patients in whom severe, life-threatening hyperkalemia and renal insufficiency developed after treatment of acute gouty arthritis with indomethacin.","This complication may result from an inhibition of prostaglandin synthesis and consequent hyporeninemic hypoaidosteronism.","Careful attention to renal function and potassium balance in patients receiving indomethacin or other nonsteroidal anti-inflammatory agents, particularly in those patients with diabetes mellitus or preexisting renal disease, will help prevent this potentially serious complication."],"text":"Indomethacin-induced hyperkalemia in three patients with gouty arthritis. We describe three patients in whom severe, life-threatening hyperkalemia and renal insufficiency developed after treatment of acute gouty arthritis with indomethacin. This complication may result from an inhibition of prostaglandin synthesis and consequent hyporeninemic hypoaidosteronism. Careful attention to renal function and potassium balance in patients receiving indomethacin or other nonsteroidal anti-inflammatory agents, particularly in those patients with diabetes mellitus or preexisting renal disease, will help prevent this potentially serious complication."}