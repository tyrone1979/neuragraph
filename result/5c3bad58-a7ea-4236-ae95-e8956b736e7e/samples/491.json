{"entities":[{"pmid":"7565311","text":"Acute renal failure","etype":"Disease","mesh":"D058186","start":0,"end":19},{"pmid":"7565311","text":"carboplatin","etype":"Chemical","mesh":"D016190","start":33,"end":44},{"pmid":"7565311","text":"Carboplatin","etype":"Chemical","mesh":"D016190","start":59,"end":70},{"pmid":"7565311","text":"acute renal failure","etype":"Disease","mesh":"D058186","start":98,"end":117},{"pmid":"7565311","text":"carboplatin","etype":"Chemical","mesh":"D016190","start":232,"end":243},{"pmid":"7565311","text":"embryonal rhabdomyosarcoma","etype":"Disease","mesh":"D018233","start":273,"end":299},{"pmid":"7565311","text":"Acute renal failure","etype":"Disease","mesh":"D058186","start":301,"end":320}],"gold_relations":"carboplatin | CID | Acute renal failure","metrics":{"precision":0.5,"recall":1.0,"f1":0.6666666666666666,"tp":1,"fp":1,"fn":0,"rel_precision":0.5,"rel_recall":1.0,"rel_f1":0.6666666666666666,"rel_tp":1,"rel_fp":1,"rel_fn":0},"pmid":"7565311","relations":["D016190 | CID | D058186","D016190 | CID | D018233"],"text":"Acute renal failure in high dose carboplatin chemotherapy. Carboplatin has been reported to cause acute renal failure when administered in high doses to adult patients. We report a 4 1/2-year-old girl who was treated with high-dose carboplatin for metastatic parameningeal embryonal rhabdomyosarcoma. Acute renal failure developed followed by a slow partial recovery of renal function. Possible contributing factors are discussed."}