:"D009270","start":514,"end":522},{"pmid":"11900788","text":"catalepsy","etype":"Disease","mesh":"D002375","start":538,"end":547},{"pmid":"11900788","text":"morphine","etype":"Chemical","mesh":"D009020","start":559,"end":567},{"pmid":"11900788","text":"nicotine","etype":"Chemical","mesh":"D009538","start":573,"end":581},{"pmid":"11900788","text":"atropine","etype":"Chemical","mesh":"D001285","start":617,"end":625},{"pmid":"11900788","text":"hexamethonium","etype":"Chemical","mesh":"D018738","start":691,"end":704},{"pmid":"11900788","text":"morphine","etype":"Chemical","mesh":"D009020","start":747,"end":755},{"pmid":"11900788","text":"morphine","etype":"Chemical","mesh":"D009020","start":779,"end":787},{"pmid":"11900788","text":"catalepsy","etype":"Disease","mesh":"D002375","start":788,"end":797},{"pmid":"11900788","text":"morphine","etype":"Chemical","mesh":"D009020","start":875,"end":883},{"pmid":"11900788","text":"nicotine","etype":"Chemical","mesh":"D009538","start":895,"end":903}],"gold_relations":"morphine | CID | catalepsy\nnicotine | CID | catalepsy","metrics":{"precision":0.2222222222222222,"recall":1.0,"f1":0.36363636363636365,"tp":2,"fp":7,"fn":0,"rel_precision":0.2222222222222222,"rel_recall":1.0,"rel_f1":0.36363636363636365,"rel_tp":2,"rel_fp":7,"rel_fn":0},"pmid":"11900788","relations":["D008464 | CID | D002375","D009020 | CID | D009538","D009020 | CID | D002375","D018738 | CID | D002375","D008464 | CID | D009538","D001285 | CID | D009538","D001285 | CID | D002375","D009538 | CID | D002375","D009270 | CID | D002375"],"text":"Nicotine potentiation of morphine-induced catalepsy in mice. In the present study, effects of nicotine on catalepsy induced by morphine in mice have been investigated. Morphine but not nicotine induced a dose-dependent catalepsy. The response of morphine was potentiated by nicotine. Intraperitoneal administration of atropine, naloxone, mecamylamine, and hexamethonium to mice reduced catalepsy induced by a combination of morphine with nicotine. Intracerebroventricular injection of atropine, hexamethonium, and naloxone also decreased catalepsy induced by morphine plus nicotine. Intraperitoneal administration of atropine, but not intraperitoneal or intracerebroventricular injection of hexamethonium, decreased the effect of a single dose of morphine. It was concluded that morphine catalepsy can be elicited by opioid and cholinergic receptors, and the potentiation of morphine induced by nicotine may also be mediated through cholinergic receptor mechanisms."}